def parse_host_port(s: str):
    if ":" not in s:
        raise argparse.ArgumentTypeError("Expected HOST:PORT")
    host, port = s.rsplit(":", 1)
    try:
        port = int(port)
    except ValueError:
        raise argparse.ArgumentTypeError("Port must be an integer")
    return host, port


def build_template_values(profile_name: str, chall: str, overrides: dict):
    if profile_name not in PROFILES:
        raise ValueError(f"Unknown profile '{profile_name}'. Add it to PROFILES.")
    base = PROFILES[profile_name].copy()

    if overrides.get("remote"):
        h, p = overrides["remote"]
        base["remote_host"] = h
        base["remote_port"] = p

    if overrides.get("ssh_host"):
        base["ssh_host"] = overrides["ssh_host"]
    if overrides.get("ssh_user"):
        base["ssh_user"] = overrides["ssh_user"]
    if "ssh_pass" in overrides and overrides["ssh_pass"] is not None:
        base["ssh_pass"] = overrides["ssh_pass"]
    if overrides.get("ssh_port"):
        base["ssh_port"] = overrides["ssh_port"]
    if "ssh_keyfile" in overrides and overrides["ssh_keyfile"] is not None:
        base["ssh_keyfile"] = overrides["ssh_keyfile"]

    if base.get("ssh_keyfile"):
        ssh_keyfile_expr = f"os.path.expanduser({repr(base['ssh_keyfile'])})"
    else:
        ssh_keyfile_expr = "None"

    vals = {
        "CHALL": chall,
        "REMOTE_HOST": base["remote_host"],
        "REMOTE_PORT": base["remote_port"],
        "SSH_HOST": base["ssh_host"],
        "SSH_USER": base["ssh_user"],
        "SSH_PASS": base["ssh_pass"],
        "SSH_PORT": base["ssh_port"],
        "SSH_KEYFILE_EXPR": ssh_keyfile_expr,
        "SSH_PATH": chall,
    }
    return vals


def ensure_symlink(src_path: str, link_path: str):
    """
    Tạo symlink trỏ từ src_path đến link_path
    """
    # Nếu file nguồn không tồn tại, cảnh báo nhưng vẫn cho phép tạo link (có thể file nguồn sẽ có sau)
    if not os.path.exists(src_path):
        print(f"[warn] Source file for symlink does not exist: {src_path}")

    if os.path.exists(link_path):
        if os.path.islink(link_path) and os.path.realpath(
            link_path
        ) == os.path.realpath(src_path):
            print(f"[ok] symlink '{os.path.basename(link_path)}' already correct.")
            return
        backup = link_path + ".bak"
        print(f"[warn] '{link_path}' exists — move to '{backup}'")
        try:
            os.replace(link_path, backup)
        except Exception as e:
            print(f"[err] failed to move existing '{link_path}': {e}")
            sys.exit(1)
    try:
        os.symlink(src_path, link_path)
        print(f"[ok] created symlink '{os.path.basename(link_path)}' -> '{src_path}'")
    except Exception as e:
        print(f"[err] failed to create symlink: {e}")
        sys.exit(1)


def write_exploit(exploit_path: str, content: str):
    if os.path.exists(exploit_path):
        backup = exploit_path + ".bak"
        print(
            f"[warn] '{os.path.basename(exploit_path)}' exists — backing up to '{backup}'"
        )
        try:
            os.replace(exploit_path, backup)
        except Exception as e:
            print(f"[err] failed to backup existing exploit: {e}")
            sys.exit(1)
    try:
        with open(exploit_path, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"[ok] wrote '{os.path.basename(exploit_path)}'")
    except Exception as e:
        print(f"[err] failed to write exploit file: {e}")
        sys.exit(1)


def make_executable(path: str):
    try:
        st = os.stat(path)
        os.chmod(path, st.st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        print(f"[ok] set executable bit on '{os.path.basename(path)}'")
    except Exception as e:
        print(f"[err] failed to chmod: {e}")


def open_in_nvim(filepath):
    try:
        subprocess.run(["nvim", filepath])
    except FileNotFoundError:
        print("[warn] nvim not found in PATH.")
        print(f"Open the file manually: {filepath}")
    except Exception as e:
        print(f"[warn] failed to launch nvim: {e}")


