def gen_pwncollege(args):
    """
    Logic xử lý riêng cho cờ -c:
    1. Tìm pwncollege.py cùng thư mục với script này.
    2. Copy sang thư mục hiện tại với tên <chall_name>.py
    3. Tạo symlink pwnld.py từ file cùng thư mục script này.
    """
    # 1. Xác định file nguồn (nằm cùng thư mục với genscr)
    src_template = os.path.join(SCRIPT_DIR, "pwncollege.py")
    src_pwnld = os.path.join(SCRIPT_DIR, "pwnld.py")

    if not os.path.exists(src_template):
        print(
            f"[err] Cannot find '{src_template}'. Ensure pwncollege.py is in the same dir as genscr."
        )
        sys.exit(1)

    # 2. Xác định tên file đích
    # Nếu args.chall_name không có đuôi .py thì thêm vào
    dest_filename = args.chall_name
    if not dest_filename.endswith(".py"):
        dest_filename += ".py"

    dest_path = os.path.join(os.getcwd(), dest_filename)

    # Thực hiện Copy template
    if os.path.exists(dest_path):
        backup = dest_path + ".bak"
        print(f"[warn] '{dest_filename}' exists — backing up to '{backup}'")
        try:
            os.replace(dest_path, backup)
        except Exception as e:
            print(f"[err] Backup failed: {e}")
            sys.exit(1)

    try:
        shutil.copyfile(src_template, dest_path)
        print(f"[ok] Copied 'pwncollege.py' to '{dest_filename}'")
    except Exception as e:
        print(f"[err] Failed to copy template: {e}")
        sys.exit(1)

    # Cấp quyền thực thi cho file mới copy
    make_executable(dest_path)

    # 3. Tạo symlink pwnld.py (Dùng file ở cùng thư mục SCRIPT_DIR)
    dest_link = os.path.join(os.getcwd(), PWNLD_LINK_NAME)
    ensure_symlink(src_pwnld, dest_link)

    # 4. Mở nvim (nếu không cấm)
    if not args.no_open:
        open_in_nvim(dest_path)


