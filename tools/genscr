def convert_to_retry(old: str, rtype: str) -> str:
    """Chuyển exploit 1-shot (phong cách pwnld) thành bản retry, best-effort.

    Cách làm: cắt ở lần gọi start() đầu tiên — phần TRƯỚC là setup (giữ ngoài),
    phần TỪ start() trở đi là runtime (gói vào attempt(i)). Tự: bỏ 'p ='/GDB()/
    .close() trong vòng, đổi interactive()/ia() -> return điều-kiện-trúng.
    Chỗ không chắc → để comment '# TODO(retry): ...' trỏ về exploit_not_retry.py.
    """
    lines = old.splitlines()
    notes = []

    # 1. điểm cắt: dòng đầu tiên gọi start( (bỏ qua dòng comment)
    split = None
    for i, ln in enumerate(lines):
        if re.search(r"\bstart\s*\(", ln) and not ln.lstrip().startswith("#"):
            split = i
            break
    if split is None:
        notes.append("không thấy start() ở bản cũ → tự chép phần runtime vào attempt().")
        header, body = lines, []
    else:
        header, body = lines[:split], lines[split:]

    # tách shebang để luôn ở dòng đầu file
    shebang = None
    if header and header[0].lstrip().startswith("#!"):
        shebang = header[0]
        header = header[1:]

    # phát hiện vòng lặp thủ công cũ (nếu có) → cảnh báo
    if re.search(r"^\s*(for\s+\w+\s+in\s+range|while\s+)", old, re.M):
        notes.append("bản cũ có vòng lặp thủ công → đã bỏ, retry() lo lặp. Soát lại thân attempt.")

    # 2. chèn import pwnretry
    imp = "from pwnretry import retry, got_shell, got_flag"
    out_header, inserted = [], False
    for ln in header:
        out_header.append(ln)
        if not inserted and re.match(r"\s*from\s+pwnld\s+import", ln):
            out_header.append(imp)
            inserted = True
    if not inserted:
        out_header = [imp] + out_header
        notes.append("không thấy 'from pwnld import *' → đã chèn import pwnretry ở đầu, kiểm tra lại.")

    # flag mode cần FLAG_RE
    succ = "got_flag(FLAG_RE)" if rtype == "flag" else "got_shell()"
    if rtype == "flag" and "FLAG_RE" not in "\n".join(out_header):
        out_header += ["", r"FLAG_RE = rb'flag\{[^}]+\}'   # TODO(retry): sửa định dạng flag"]

    # 3. biến đổi body → thân attempt
    attempt_lines, found_hit = [], False
    for ln in body:
        indent = re.match(r"(\s*)", ln).group(1)
        if re.search(r"\bstart\s*\(", ln):
            ln = re.sub(r"^(\s*)(?:[\w.]+\s*=\s*)?start\s*\(", r"\1start(", ln)
        if re.search(r"\bGDB\s*\(\s*\)", ln):
            ln = f"{indent}# GDB()  # bật khi debug: tries=1 + mode 11"
        elif re.search(r"\.close\s*\(\s*\)", ln):
            ln = f"{indent}# {ln.strip()}  # retry tự đóng tube khi trượt"
        elif re.search(r"\bia\s*\(\s*\)|[\w.]+\.interactive\s*\(\s*\)", ln):
            ln = f"{indent}return {succ}  # <- tự sinh: ĐIỀU KIỆN TRÚNG"
            found_hit = True
        attempt_lines.append(ln)

    if not found_hit:
        attempt_lines.append(f"    return {succ}  # TODO(retry): chưa thấy ia()/interactive() — tự đặt điều kiện trúng")
        notes.append("chưa thấy ia()/interactive() cuối bản cũ → thêm 'return' tạm, tự chỉnh điều kiện trúng.")

    # bỏ dòng trống thừa ở cuối phần setup cho gọn
    while out_header and not out_header[-1].strip():
        out_header.pop()

    # 4. ráp
    banner = [
        "# === genscr retry (convert) — bản 1-shot cũ: exploit_not_retry.py ===",
        "# Đã tự: tách setup ra ngoài · gói runtime vào attempt(i) · start() đầu hàm",
        "#        · bỏ GDB()/close() trong vòng · interactive() -> return điều-kiện-trúng.",
    ]
    banner += [f"# TODO(retry): {n}" for n in notes]
    banner += [""]

    if rtype == "flag":
        tail = ["", "flag, n = retry(attempt, tries=300, on_hit='return')",
                "if flag:", "    log.success(flag.decode())", "    print(flag.decode())"]
    else:
        tail = ["", "# tries: 1/16 ~ 48-64 | 1/256 ~ 512-1024 | ASLR ~ 100-300",
                "retry(attempt, tries=200)   # trúng -> tự interactive()"]

    doc = []
    if shebang:
        doc.append(shebang)
    doc += banner
    doc += out_header
    doc += ["", "", "def attempt(i):"]
    doc += ["    " + l if l.strip() else l for l in attempt_lines]
    doc += tail
    return "\n".join(doc) + "\n"


# Macro pwnld chạy trên tube → cần thêm tiền tố 't.' khi biên sang Session.
# (không đụng p64/flat/asm/log... vì chúng KHÔNG phải method của tube)
PWNLD_TUBE_MACROS = [
    "sla", "slna", "sna", "sln", "sa", "sl", "sn", "s",
    "ru", "rc", "ra", "rl", "rr",
    "leak_all", "leak_libc", "leak_stack", "leak_bin", "leak_heap",
    "got_shell", "got_flag",
]
_MACRO_RE = re.compile(r"(?<![\w.])(" + "|".join(PWNLD_TUBE_MACROS) + r")(\s*\()")


def _prefix_macros(line: str) -> str:
    """Thêm 't.' trước mỗi macro tube (sla(...) -> t.sla(...)); chừa p64/flat/..."""
    return _MACRO_RE.sub(r"t.\1\2", line)


def convert_to_parallel(old: str) -> str:
    """Biên exploit kiểu pwnld (p toàn cục) -> bản PARALLEL dùng Session.

    Ánh xạ 1-1: start() -> t = Session(); mỗi macro tube (sla/ru/rl/...) -> t.<macro>;
    GDB()/close() bỏ (finally lo); ia()/interactive() -> return t.got_flag(FLAG_RE).
    Thân chạy trong try/finally để mỗi luồng tự đóng tube.
    """
    lines = old.splitlines()
    notes = []

    split = None
    for i, ln in enumerate(lines):
        if re.search(r"\bstart\s*\(", ln) and not ln.lstrip().startswith("#"):
            split = i
            break
    if split is None:
        notes.append("không thấy start() ở bản cũ → tự chép runtime vào attempt().")
        header, body = lines, []
    else:
        header, body = lines[:split], lines[split:]

    shebang = None
    if header and header[0].lstrip().startswith("#!"):
        shebang = header[0]
        header = header[1:]

    if re.search(r"^\s*(for\s+\w+\s+in\s+range|while\s+)", old, re.M):
        notes.append("bản cũ có vòng lặp thủ công → đã bỏ, retry_parallel lo lặp.")

    # import pwnretry (parallel)
    imp = "from pwnretry import retry_parallel, Session"
    out_header, inserted = [], False
    for ln in header:
        out_header.append(ln)
        if not inserted and re.match(r"\s*from\s+pwnld\s+import", ln):
            out_header.append(imp)
            inserted = True
    if not inserted:
        out_header = [imp] + out_header
        notes.append("không thấy 'from pwnld import *' → chèn import pwnretry ở đầu.")

    if "FLAG_RE" not in "\n".join(out_header):
        out_header += ["", r"FLAG_RE = rb'flag\{[^}]+\}'   # TODO(retry): sửa định dạng flag"]

    while out_header and not out_header[-1].strip():
        out_header.pop()

    # thân (body[0] là dòng start → thành Session, tách riêng; còn lại vào try)
    inner, found_hit = [], False
    for ln in body[1:]:
        indent = re.match(r"(\s*)", ln).group(1)
        stripped = ln.lstrip()
        if stripped.startswith("#"):
            inner.append(ln)
        elif re.search(r"\bGDB\s*\(\s*\)", ln):
            inner.append(f"{indent}# GDB() bỏ — parallel không attach được")
        elif re.search(r"\.close\s*\(\s*\)", ln):
            inner.append(f"{indent}# {stripped}  # bỏ — finally t.close() đã lo")
        elif re.search(r"\bia\s*\(\s*\)|[\w.]+\.interactive\s*\(\s*\)", ln):
            inner.append(f"{indent}return t.got_flag(FLAG_RE)  # <- parallel: ĐIỀU KIỆN TRÚNG")
            found_hit = True
        else:
            inner.append(_prefix_macros(ln))
    if not found_hit:
        inner.append("return t.got_flag(FLAG_RE)  # TODO(retry): đặt điều kiện trúng")
        notes.append("chưa thấy ia()/interactive() → thêm 'return t.got_flag' tạm.")

    banner = [
        "# === genscr retry parallel (biên từ 1-shot) — bản cũ: exploit_not_retry.py ===",
        "# Đã tự: start() -> t=Session() · macro pwnld -> t.<macro> · GDB()/close() bỏ",
        "#        · interactive() -> return t.got_flag(FLAG_RE) · bọc try/finally.",
    ]
    banner += [f"# TODO(retry): {n}" for n in notes]
    banner += [""]

    doc = []
    if shebang:
        doc.append(shebang)
    doc += banner
    doc += out_header
    doc += ["", "", "def attempt(i):", "    t = Session()", "    try:"]
    doc += ["        " + l if l.strip() else l for l in inner]
    doc += ["    finally:", "        t.close()"]
    doc += ["", "# workers: 8-32 tuỳ server chịu được",
            "flag, runs = retry_parallel(attempt, tries=1024, workers=16)",
            "if flag:", "    log.success(flag.decode())", "    print(flag.decode())"]
    return "\n".join(doc) + "\n"


def gen_retry(args):
    """Xử lý chế độ retry: skeleton sạch (binary) hoặc convert (file .py cũ)."""
    rtype = (args.retry_type or "shell").lower()
    if rtype not in RETRY_TYPES:
        print(f"[err] loại retry phải là một trong: {', '.join(RETRY_TYPES)}")
        sys.exit(1)

    cwd = os.getcwd()
    target = args.chall_name
    target_abs = target if os.path.isabs(target) else os.path.join(cwd, target)
    exploit_path = os.path.join(cwd, EXPLOIT_NAME)
    pwnld_link = os.path.join(cwd, PWNLD_LINK_NAME)
    pwnretry_link = os.path.join(cwd, PWNRETRY_LINK_NAME)

    is_convert = os.path.isfile(target_abs) and target.endswith(".py")

    if is_convert:
        with open(target_abs, encoding="utf-8") as f:
            old = f.read()
        old_keep = os.path.join(cwd, EXPLOIT_OLD_NAME)
        if os.path.exists(old_keep):
            os.replace(old_keep, old_keep + ".bak")
            print(f"[warn] '{EXPLOIT_OLD_NAME}' đã có → backup '.bak'")
        os.replace(target_abs, old_keep)
        print(f"[ok] giữ bản cũ: '{EXPLOIT_OLD_NAME}'")
        new_src = convert_to_parallel(old) if rtype == "parallel" else convert_to_retry(old, rtype)
        with open(exploit_path, "w", encoding="utf-8") as f:
            f.write(new_src)
        print(f"[ok] sinh '{EXPLOIT_NAME}' (retry/{rtype}) từ bản cũ — soát '# TODO(retry)'")
    else:
        chall = os.path.basename(target)
        prof = "xyz" if args.xyz else (args.profile or "generic")
        overrides = {
            "remote": args.remote, "ssh_host": args.ssh_host, "ssh_user": args.ssh_user,
            "ssh_pass": args.ssh_pass, "ssh_port": args.ssh_port, "ssh_keyfile": args.ssh_keyfile,
        }
        try:
            vals = build_template_values(prof, chall, overrides)
        except Exception as e:
            print(f"[err] {e}")
            sys.exit(1)
        write_exploit(exploit_path, RETRY_TEMPLATES[rtype].format(**vals))
        print(f"[ok] khung retry/{rtype} sạch cho '{chall}'")

    make_executable(exploit_path)
    ensure_symlink(args.pwnretry_src, pwnretry_link)
    ensure_symlink(args.pwnld_src, pwnld_link)  # Session đọc CFG.HOST/PORT từ pwnld

    if not args.no_open:
        open_in_nvim(exploit_path)


class GenscrHelpFormatter(argparse.RawDescriptionHelpFormatter):
    SECTION_TITLES = (
        "ĐỐI SỐ",
        "TÙY CHỌN CHUNG",
        "PRESET (chọn tối đa một)",
        "KẾT NỐI (ghi đè profile)",
        "TEMPLATE VÀ FILE",
    )

    def _format_usage(self, usage, actions, groups, prefix):
        if prefix in (None, "usage: "):
            prefix = "CÁCH DÙNG: "
        return super()._format_usage(usage, actions, groups, prefix)

    @staticmethod
    def _color_mode():
        for index, arg in enumerate(sys.argv[1:], 1):
            if arg.startswith("--color="):
                value = arg.split("=", 1)[1]
                if value in {"auto", "always", "never"}:
                    return value
            if arg == "--color" and index + 1 < len(sys.argv):
                value = sys.argv[index + 1]
                if value in {"auto", "always", "never"}:
                    return value
        return "auto"

    def format_help(self):
        import shutil

        text = super().format_help()
        width = max(40, shutil.get_terminal_size((88, 24)).columns - 2)
        color_mode = self._color_mode()
        color = color_mode == "always" or (
            color_mode == "auto"
            and sys.stdout.isatty()
            and os.environ.get("TERM") != "dumb"
            and "NO_COLOR" not in os.environ
        )

        def frame(title):
            label = f" {title} "
            left, right = "╭─", "─╮"
            fill = "─" * max(0, width - len(left) - len(label) - len(right))
            if color:
                return (
                    "\033[36m" + left + "\033[0m"
                    + "\033[1;97;44m" + label + "\033[0m"
                    + "\033[36m" + fill + right + "\033[0m"
                )
            return left + label + fill + right

        for title in self.SECTION_TITLES:
            text = text.replace(f"{title}:\n", frame(title) + "\n")

        if color:
            def usage_banner(match):
                line = match.group(0).ljust(width)
                return "\033[1;97;44m" + line + "\033[0m"

            text = re.sub(r"(?m)^CÁCH DÙNG:.*$", usage_banner, text)
            text = re.sub(
                r"(?<![\w])(?:--[a-z][a-z0-9-]*|-[a-z])(?=[\s,])",
                lambda match: "\033[96m" + match.group(0) + "\033[0m",
                text,
            )
        return text


