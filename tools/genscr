        help="địa chỉ dịch vụ TCP, ví dụ chall.example:31337",
    )
    g_conn.add_argument("--ssh-host", metavar="HOST", default=None, help="máy chủ SSH")
    g_conn.add_argument("--ssh-user", metavar="USER", default=None, help="tài khoản SSH")
    g_conn.add_argument("--ssh-pass", metavar="PASS", default=None, help="mật khẩu SSH")
    g_conn.add_argument("--ssh-port", metavar="PORT", type=int, default=None, help="cổng SSH")
    g_conn.add_argument("--ssh-keyfile", metavar="FILE", default=None, help="đường dẫn SSH key")

